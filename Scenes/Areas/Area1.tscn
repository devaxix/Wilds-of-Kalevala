[node name="WallJumpOrb" parent="." instance=ExtResource("17_b6jro")]
position = Vector2(12208, 1317)
scale = Vector2(3.835, 3.835)
dialogue_lines = Array[String](["Your fingers remember the rough bark of the Great Oak.", "No wall is too high when the forest grants you purchase.", "Climb out of the dark. Reach for the sun that was hidden.", "Jump against a wall to Wall Jump!"])

[node name="MemoryOrb" parent="." instance=ExtResource("16_r6rcv")]
position = Vector2(5094, 352)
scale = Vector2(3.835, 3.835)
dialogue_lines = Array[String](["You feel a flicker of something familiar. A voice, a laugh. Maybe your own.", "The blue figure… it’s not running away. It’s showing you how to follow warmth again.", "The lightning of Ukko flows through your blade once more.", "Attack by pressing Left Click or Z."])

[node name="LevelExit" parent="." instance=ExtResource("27_lfkt4")]
position = Vector2(33504, 1568)
scale = Vector2(22.47, 22.47)
next_level_path = "uid://favsoqxjmbpc"

[node name="DashOrb" parent="." instance=ExtResource("29_vlhvw")]
position = Vector2(23547, 973.99994)
scale = Vector2(3.835, 3.835)
dialogue_lines = Array[String](["Your heart beats to the rhythm of the chase. You remember the hunt.", "Swift as the Elk of Hiisi, elusive as a shadow.", "Leave your past behind in a blur. Become the streak of light you once wished for.", "Press Shift to Dash."])

[node name="DoubleJumpOrb" parent="." instance=ExtResource("30_gtggk")]
position = Vector2(2376, 704)
scale = Vector2(3.835, 3.835)
dialogue_lines = Array[String](["A memory of feathers... or is it the wind?", "Ilmatar, the Spirit of the Air, lends you her breath.", "The earth is not your only foundation. You do not fall... you rise.", "Press Jump again in mid-air to Double Jump."])

